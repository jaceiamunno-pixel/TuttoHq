# Supabase — database, auth, and storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Anthropic — Claude Haiku for classification + search expansion
ANTHROPIC_API_KEY="sk-ant-..."

# App URL — used for OAuth redirect URIs (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — Gmail connection (per-user)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Google Pub/Sub — topic that receives Gmail watch notifications
# Format: projects/<gcp-project-id>/topics/<topic-name>
GOOGLE_PUBSUB_TOPIC="projects/your-gcp-project/topics/gmail-intake"

# Shared secret validating inbound Pub/Sub POSTs to /api/gmail-intake
GMAIL_WEBHOOK_SECRET="long-random-string"

# Vercel Cron shared secret. Vercel's cron runner sends every scheduled
# invocation with `Authorization: Bearer ${CRON_SECRET}`; the cron route
# rejects any request whose header doesn't match. Set this to the SAME
# value in Vercel project env vars (Settings -> Environment Variables)
# before the first cron tick — otherwise every cron run will 401.
# Generate with: openssl rand -hex 32
CRON_SECRET="set-a-random-32-byte-hex-here"
