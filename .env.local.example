# Google Service Account credentials
# The email address of the service account (looks like: name@project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# The private key from the service account JSON key file.
# Copy the entire "private_key" value including -----BEGIN/END----- lines.
# Replace all real newlines with \n so it fits on one line.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# The Google Drive folder ID to search within.
# Get it from the folder's URL: drive.google.com/drive/folders/THIS_PART_HERE
GOOGLE_DRIVE_FOLDER_ID="1aBcDeFgHiJkLmNoPqRsTuVwXyZ"
