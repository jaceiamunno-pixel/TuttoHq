# Supabase — database, auth, and storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Anthropic — Claude Haiku for classification + search expansion
ANTHROPIC_API_KEY="sk-ant-..."

# Upstash Redis — API rate limiting (Tier 1 abuse + Tier 2 AI/PDF cost caps).
# Server-only — DO NOT prefix with NEXT_PUBLIC_. Create a free database at
# https://console.upstash.com and copy its REST URL + token here.
# NOTE: the Tier-2 (expensive AI/parse) routes FAIL CLOSED — without these set
# they return 503. Set them locally and in Vercel before deploying.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# App URL — used for OAuth redirect URIs (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Absolute origin the ADR-010 native shell calls for /api/* (no trailing slash).
# Web builds ignore this (they use relative /api). MUST be the canonical,
# NON-redirecting host — the apex tuttohq.com 307-redirects to www, which strips
# the native Authorization header. Leave unset to use the code default
# (https://www.tuttohq.com); override only to point the native build at a preview.
# NEXT_PUBLIC_API_BASE_URL="https://www.tuttohq.com"

# Google OAuth — Gmail connection (per-user)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Google Pub/Sub — topic that receives Gmail watch notifications
# Format: projects/<gcp-project-id>/topics/<topic-name>
GOOGLE_PUBSUB_TOPIC="projects/your-gcp-project/topics/gmail-intake"

# Shared secret validating inbound Pub/Sub POSTs to /api/gmail-intake
GMAIL_WEBHOOK_SECRET="long-random-string"

# Vercel Cron shared secret. Vercel's cron runner sends every scheduled
# invocation with `Authorization: Bearer ${CRON_SECRET}`; the cron route
# rejects any request whose header doesn't match. Set this to the SAME
# value in Vercel project env vars (Settings -> Environment Variables)
# before the first cron tick — otherwise every cron run will 401.
# Generate with: openssl rand -hex 32
CRON_SECRET="set-a-random-32-byte-hex-here"
