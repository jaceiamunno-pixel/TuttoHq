.next/
node_modules/
.env.local
# Never commit a native env file. The native export loads the repo-root
# .env.local (via loadEnvConfig in native/next.config.ts), so native/.env*
# should not exist — but block it either way (the bare `.env.local` above only
# matches that exact basename, not native/.env or native/.env.production).
native/.env*
*.pem

# Capacitor native shell — static export build output (native/.next covered above)
native/out/

.vercel

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Local debugging / Excel-export harness
scripts/

# Local PDF render artifacts (screenshot tooling)
scripts/out/

# Local Claude Code state — ignore everything except the shared, committed DX tooling
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
